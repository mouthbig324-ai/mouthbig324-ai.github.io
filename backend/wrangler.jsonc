    "MAX_STORAGE_BYTES": "8000000000"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "zuige-blog-data", "database_id": "2460834a-5ff0-4e5f-85c4-c711b77c0aef", "migrations_dir": "migrations" }],
  "r2_buckets": []
}
