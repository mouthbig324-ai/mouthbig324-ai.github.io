---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import type { MarkdownHeading } from "astro";
import TOC from "../components/widget/TOC.astro";
import { siteConfig } from "../config";
import Layout from "./Layout.astro";
interface Props {
  title?: string; banner?: string; description?: string; lang?: string;
  setOGTypeArticle?: boolean; headings?: MarkdownHeading[];
}
const { title, banner, description, lang, setOGTypeArticle, headings = [] } = Astro.props;
---
<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle}>
  <slot slot="head" name="head" />
  <a class="journal-skip" href="#swup-container">跳到正文</a>
  <header id="top-row" class="journal-header"><div id="navbar-wrapper"><Navbar /></div></header>
  <div id="main-grid" class="journal-shell">
    <main id="swup-container" class="transition-swup-fade" tabindex="-1">
      <div id="content-wrapper" class:list={["onload-animation", { "journal-reading": setOGTypeArticle }]}><slot /></div>
    </main>
    <Footer /><BackToTop />
  </div>
  <aside id="toc-wrapper" class="journal-toc" aria-label="文章目录">
    <div id="toc-inner-wrapper" class="hide-scrollbar"><div id="toc" class="transition-swup-fade">
      {siteConfig.toc.enable && headings.length > 0 && <><p class="journal-eyebrow">本篇目录</p><TOC headings={headings} /></>}
    </div></div>
  </aside>
</Layout>
