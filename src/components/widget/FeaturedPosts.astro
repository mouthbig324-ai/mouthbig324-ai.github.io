---
import { getSortedPosts } from "../../utils/content-utils";
import { getPostUrlBySlug } from "../../utils/url-utils";
import WidgetLayout from "./WidgetLayout.astro";
const posts = (await getSortedPosts()).filter(post => post.data.featured).slice(0, 5);
---
{posts.length > 0 && <WidgetLayout id="featured-records" name="精选记录"><div class="flex flex-col gap-3 py-2">{posts.map(post => <a class="group" href={getPostUrlBySlug(post.slug)}><p class="text-75 group-hover:text-[var(--primary)] font-medium">{post.data.title}</p><time class="text-50 text-xs">{post.data.published.toISOString().slice(0, 10)}</time></a>)}</div></WidgetLayout>}
