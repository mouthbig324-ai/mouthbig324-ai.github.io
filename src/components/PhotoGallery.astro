---
import { mediaUrl } from "../utils/album-utils";
interface Props {
  photos: { src: string; thumbnail?: string; alt?: string; width: number; height: number }[];
  videos?: { src: string; caption?: string }[];
}
const { photos, videos = [] } = Astro.props;
---
{photos.length > 0 && <div class:list={["journal-gallery my-6 grid gap-3", photos.length === 1 ? "grid-cols-1" : "grid-cols-2 md:grid-cols-3"]}>
  {photos.map(photo => <figure class="m-0">
    <a class="block overflow-hidden rounded-xl" href={mediaUrl(photo.src)} data-pswp-width={photo.width} data-pswp-height={photo.height} aria-label={photo.alt || "放大查看照片"}>
      <img class:list={["w-full object-cover transition hover:scale-[1.02]", photos.length > 1 && "aspect-square"]} src={mediaUrl(photo.thumbnail || photo.src)} alt={photo.alt || "照片"} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
    </a>
    {photo.alt && <figcaption class="text-center text-sm text-50 mt-2">{photo.alt}</figcaption>}
  </figure>)}
</div>}
{videos.map(video => <figure class="my-6"><video class="w-full rounded-xl max-h-[75vh] bg-black" src={mediaUrl(video.src)} controls playsinline preload="metadata"></video>{video.caption && <figcaption class="text-center text-sm text-50 mt-2">{video.caption}</figcaption>}</figure>)}
<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";
  let lightbox: PhotoSwipeLightbox | undefined;
  const mount = () => { lightbox?.destroy(); lightbox = new PhotoSwipeLightbox({ gallery: ".journal-gallery", children: "a", pswpModule: () => import("photoswipe") }); lightbox.init(); };
  const setup = () => { mount(); window.swup.hooks.on("page:view", mount); window.swup.hooks.on("content:replace", () => lightbox?.destroy(), { before: true }); };
  if (window.swup) setup(); else document.addEventListener("swup:enable", setup, { once: true });
</script>
