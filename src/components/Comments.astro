---
import { apiBase } from "../utils/services";
interface Props { path: string }
const { path } = Astro.props;
---
{apiBase && <section id="comments" class="card-base px-6 md:px-9 py-7 mt-4 comments" data-api={apiBase} data-path={path}>
  <h2 class="text-90 text-xl font-bold mb-2">评论区</h2>
  <p class="text-50 text-sm mb-5">欢迎聊聊你的感受。邮箱不会公开。</p>
  <div class="comment-list flex flex-col gap-4 mb-6" aria-live="polite"></div>
  <form class="comment-form flex flex-col gap-3">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3"><input name="name" maxlength="40" placeholder="昵称" aria-label="昵称" required /><input name="email" type="email" maxlength="160" placeholder="邮箱（不公开）" aria-label="邮箱" required /></div>
    <input name="company" class="comment-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <textarea name="body" rows="4" maxlength="3000" placeholder="写下你的留言…" aria-label="留言内容" required></textarea>
    <div class="flex items-center gap-4"><button class="btn-regular rounded-xl px-5 py-3 font-medium" type="submit">发表留言</button><p class="comment-status text-sm text-50" role="status"></p></div>
  </form>
</section>}
<style>
  input, textarea { padding: .8rem 1rem; border-radius: .7rem; color: inherit; background: var(--page-bg); outline: none; border: 1px solid transparent; }
  input:focus, textarea:focus { border-color: var(--primary); }
  .comment-honeypot { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
</style>
<script>
  import { mountComments } from "../scripts/comments";
  mountComments();
  const setup = () => { window.swup?.hooks.on("page:view", mountComments); };
  if (window.swup) setup(); else document.addEventListener("swup:enable", setup, { once: true });
</script>
