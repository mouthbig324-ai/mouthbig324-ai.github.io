---
interface Props { title: string; description: string; eyebrow?: string }
const { title, description, eyebrow = "嘴哥的生活记录" } = Astro.props;
---
<header class="card-base px-6 md:px-9 py-8 md:py-10 mb-4">
  <p class="text-sm tracking-widest text-[var(--primary)] font-medium mb-4">{eyebrow}</p>
  <h1 class="text-90 text-3xl md:text-4xl font-bold leading-tight mb-4">{title}</h1>
  <p class="text-75 leading-8">{description}</p>
</header>
