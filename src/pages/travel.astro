---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import JournalHeader from "../components/JournalHeader.astro";
import PostCard from "../components/PostCard.astro";
import { getSortedPosts } from "../utils/content-utils";
import { getPostUrlBySlug } from "../utils/url-utils";
import { url } from "../utils/url-utils";
import { getTravelSeries } from "../utils/travel-series";
import TravelSeriesCards from "../components/TravelSeriesCards.astro";
const series = await getTravelSeries();
const posts = (await getSortedPosts()).filter(post => post.data.category === "旅行日记");
---
<MainGridLayout title="旅行日记" description="用照片与文字，记下沿途的风景。">
  <JournalHeader title="旅行日记" description="走过的路、看过的风景，都在这里留一页。" />
  <div class="flex items-center justify-between gap-4 mb-4 px-2"><h2 class="text-xl font-bold text-90">按旅程回看</h2><a href={url("/series/")} class="text-[var(--primary)]">全部旅行系列 →</a></div>
  <TravelSeriesCards series={series} />
  <h2 class="text-xl font-bold text-90 px-2 mb-4">旅行日记</h2>
  <div class="flex flex-col gap-4">
    {posts.map(entry => <PostCard entry={entry} {...entry.data} url={getPostUrlBySlug(entry.slug)} style="" />)}
    {posts.length === 0 && <div class="card-base px-6 md:px-9 py-14 text-center"><p class="text-90 text-xl font-medium mb-3">下一站，慢慢记录。</p><p class="text-50">第一篇旅行日记，还在路上。</p></div>}
  </div>
</MainGridLayout>
